# Fill these locally if using Microsoft Foundry / Azure OpenAI (Responses API v1).
# Never commit real values. AZURE_OPENAI_API_VERSION is no longer used (the v1 API has none).
# Endpoint: the resource base URL, e.g. https://<resource>.services.ai.azure.com
# (".../openai/v1" or the full ".../openai/v1/responses" target URI are also accepted).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Deployment name; sent as the Responses API "model" field.
AZURE_OPENAI_DEPLOYMENT=
# Live claim checks (POST /api/live-check, `matchlens serve --live-api`).
# Card checks per UTC day across all instances (default 100): the spend cap.
MATCHLENS_LIVE_DAILY_LIMIT=
# Shared quota store: SAS URL of an Azure Table (Read, Add, Update), a secret. Without it the
# deployed API makes no live calls; a local `serve --live-api` falls back to an in-memory count.
MATCHLENS_LIVE_COUNTER_URL=
