# Fill these locally if using Microsoft Foundry / Azure OpenAI (Responses API v1).
# Never commit real values. AZURE_OPENAI_API_VERSION is no longer used (the v1 API has none).
# Endpoint: the resource base URL, e.g. https://<resource>.services.ai.azure.com
# (".../openai/v1" or the full ".../openai/v1/responses" target URI are also accepted).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Deployment name; sent as the Responses API "model" field.
AZURE_OPENAI_DEPLOYMENT=
